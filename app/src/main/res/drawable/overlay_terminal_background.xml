<?xml version="1.0" encoding="utf-8"?>
<!-- Background of the floating terminal. Its alpha is lowered at runtime when the system's
     cross-window blur is available, so the blurred content behind stays visible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F20B0D12" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
