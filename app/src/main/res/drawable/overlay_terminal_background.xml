<?xml version="1.0" encoding="utf-8"?>
<!-- Border and shape of the floating terminal. The fill is only a slight dark scrim over the live
     background blur, enough to keep text readable; the border and rounded outline also define the
     blur region. Its alpha is lowered at runtime while the sheet is rolled up, which fades the
     scrim and border out with the panel. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33000000" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
